# 필수
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 저장 위치 (프로젝트 루트 기준)
DB_PATH=hira_alert.db
LOG_PATH=hira_alert.log

# 키워드 필터 (RSS와 legacy). 쉼표 구분, 비우면 모든 새 글
INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=

# 업무포털: main(기본) | legacy | both | off
BIZ_MODE=main
BIZ_MAIN_MIN_INTERVAL=300
# legacy 전용
BIZ_BBS_IDS=BBSMSTR_000000000675
BIZ_MAX_PAGES=200

# e-Form 공지사항
EFORM_ENABLED=1
EFORM_MIN_INTERVAL=300
EFORM_PAGES=1
